# Environment Variables Example (copy to backend/.env)
JWT_SECRET=
# End the value with ;connectionLimit=30 (the default pool is only 10 connections)
DATABASE_URL=
# Password for the seeded "admin" account; no admin is created when empty
ADMIN_PASSWORD=
SMTP_USER=
SMTP_PASSWORD=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay_return
FRONTEND_URL=http://localhost:5173

# docker-compose (copy to ./.env at repo root)
DB_PASSWORD=
VITE_API_URL=http://localhost:3000

# Set to true only when running the load-test scripts (they send everything from one IP)
THROTTLE_DISABLED=false
